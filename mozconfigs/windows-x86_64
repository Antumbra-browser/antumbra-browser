# Antumbra mozconfig -- Windows x86_64
# Upstream pin: FIREFOX_153_3_0esr_RELEASE (D8)
# Build platform: Windows first (D7)

# Branding: use Antumbra, never --enable-official-branding (ARCHITECTURE.md 11.3)
ac_add_options --with-branding=browser/branding/antumbra

# Optimization: release profile
ac_add_options --enable-optimize
ac_add_options --disable-debug

# Telemetry compiled out (ARCHITECTURE.md 5.8)
ac_add_options --disable-crashreporter
ac_add_options --disable-parental-controls
ac_add_options --disable-default-browser-agent
# Extension signing: stays on (D3 -- no MOZ_REQUIRE_SIGNING=0)

# Application identity
export MOZ_APP_NAME=antumbra
export MOZ_DISTRIBUTION_ID=com.antumbra

# NSPR has pointer-type mismatches that clang 21 treats as errors in C mode.
export CFLAGS="-Wno-error=incompatible-pointer-types"

# Windows-specific: output directory
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-x86_64-pc-mingw32
